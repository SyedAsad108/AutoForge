# ============================================================
# AutoForge Smart Manufacturing Plant -- Environment Variables
# ============================================================

# --- Factory ---
FACTORY_ID=AUTOFORGE_01

# --- Telemetry ---
TELEMETRY_INTERVAL_SECONDS=1.0
BASE_ANOMALY_PROBABILITY=0.01
BASE_DEGRADATION_RATE=0.005

# --- Streaming Engine ---
STREAM_BUFFER_SIZE=5000
EVENT_RETENTION_SECONDS=300

# --- Local Event Storage (Simulator) ---
LOCAL_STORAGE_ENABLED=true
LOCAL_STORAGE_BASE_DIR=data/raw_stream
FILE_ROTATION_INTERVAL_SECONDS=300

# --- Replay Engine ---
DEFAULT_REPLAY_SPEED=1.0

# --- Correlation Engine ---
CORRELATION_ENABLED=true
MACHINE_INTERACTION_RADIUS=3

# --- Degradation Engine ---
DEGRADATION_RECOVERY_PROBABILITY=0.002
MAINTENANCE_RESET_PROBABILITY=0.001

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/autoforge.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ============================================================
# Phase 3 -- Backend Ingestion API
# ============================================================

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_NODE_ID=ingestion-node-01
DEBUG=false

# --- Security ---
API_KEY=autoforge-dev-key-2026
CORS_ORIGINS=*

# --- Ingestion Buffer ---
INGESTION_BUFFER_SIZE=10000
INGESTION_BATCH_SIZE=100

# --- Producer ---
PRODUCER_TYPE=local
LOCAL_INGESTION_DIR=data/ingestion
INGESTION_ROTATION_SECONDS=300

# --- Retry ---
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=10.0

# --- Backend Logging ---
BACKEND_LOG_FILE_ENABLED=true
BACKEND_LOG_FILE_PATH=logs/backend.log
